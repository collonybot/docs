{
  "theme": "aspen",
  "name": "collony.ai",
  "description": "AI-powered moderation and community intelligence for Telegram and Discord.",
  "colors": {
    "primary": "#0073E6",
    "light": "#4A97F0",
    "dark": "#0066CC"
  },
  "logo": {
    "light": "/logo/collony-wordmark-ink.svg",
    "dark": "/logo/collony-wordmark-white.svg",
    "href": "https://www.collony.ai"
  },
  "favicon": {
    "light": "/favicon-ink.svg",
    "dark": "/favicon-white.svg"
  },
  "appearance": {
    "strict": false
  },
  "background": {
    "color": {
      "light": "#F4F4FA",
      "dark": "#08080B"
    }
  },
  "navbar": {
    "links": []
  },
  "footer": {
    "socials": {
      "x": "https://x.com/collonybot",
      "telegram": "https://t.me/collony_official",
      "linkedin": "https://www.linkedin.com/company/collony",
      "website": "https://www.collony.ai/",
      "discord": "https://discord.com/invite/na6xcu7xV7"
    }
  },
  "search": {
    "prompt": "Search docs..."
  },
  "fonts": {
    "family": "Geist"
  },
  "icons": {
    "library": "lucide"
  },
  "redirects": [
    {
      "source": "/home",
      "destination": "/introduction",
      "permanent": true
    },
    {
      "source": "/sentiment",
      "destination": "/insights",
      "permanent": true
    },
    {
      "source": "/activity",
      "destination": "/insights",
      "permanent": true
    }
  ],
  "errors": {
    "404": {
      "redirect": true
    }
  },
  "contextual": {
    "options": [
      "copy",
      "assistant"
    ],
    "display": "header"
  },
  "thumbnails": {
    "appearance": "dark",
    "fonts": {
      "family": "Geist"
    },
    "preset": "classic",
    "surface": "neutral",
    "eyebrow": {
      "source": "group",
      "style": "plain",
      "color": "#0073E6"
    }
  },
  "metadata": {
    "timestamp": true
  },
  "seo": {
    "metatags": {
      "canonical": "https://www.collony.ai/docs"
    }
  },
